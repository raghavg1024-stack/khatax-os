generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Customer {
  id String @id @default(cuid())
  name String
  phone String @default("")
  nicknames String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries Entry[]
}
model Entry {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  kind String
  amountPaise Int
  note String @default("")
  source String @default("manual")
  occurredOn String
  createdAt DateTime @default(now())
  reversesId String? @unique
  reverses Entry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy Entry? @relation("Reversal")
  batchId String?
  @@index([customerId, occurredOn])
  @@index([createdAt])
}
model Audit {
  id String @id @default(cuid())
  event String
  entityId String
  detail String
  createdAt DateTime @default(now())
}
model Command {
  id String @id @default(cuid())
  transcript String
  actions String
  warnings String
  provider String
  state String @default("pending")
  createdAt DateTime @default(now())
}

model Product {
  id String @id @default(cuid())
  name String @unique
  sku String? @unique
  unit String @default("unit")
  stockMilli Int @default(0)
  pricePaise Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Supplier {
  id String @id @default(cuid())
  name String
  phone String @default("")
  createdAt DateTime @default(now())
}
model SupplierInvoice {
  id String @id @default(cuid())
  supplierId String
  reference String
  totalPaise Int
  taxPaise Int @default(0)
  dueOn String
  occurredOn String
  lines String
  key String @unique
  createdAt DateTime @default(now())
  @@unique([supplierId, reference])
  @@index([dueOn])
}
model SupplierPayment {
  id String @id @default(cuid())
  supplierId String
  amountPaise Int
  occurredOn String
  key String @unique
  createdAt DateTime @default(now())
}
model InventoryMovement {
  id String @id @default(cuid())
  productId String
  deltaMilli Int
  reason String
  reference String
  createdAt DateTime @default(now())
  @@index([productId])
}
model Sale {
  id String @id @default(cuid())
  customerId String?
  totalPaise Int
  mode String
  entryId String? @unique
  lines String
  key String @unique
  occurredOn String
  createdAt DateTime @default(now())
}
model CashRecord {
  id String @id @default(cuid())
  kind String
  amountPaise Int
  occurredOn String
  key String @unique
  note String @default("")
  createdAt DateTime @default(now())
}
model BusinessOperation {
  key String @id
  fingerprint String
  result String
  createdAt DateTime @default(now())
}
